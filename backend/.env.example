PORT=8787
REVENUECAT_SECRET_API_KEY=
CORS_ORIGINS=*
DATA_DIR=./data

# WhatsApp Cloud API OTP (optional — mock OTP when both unset)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta Developer Console → WhatsApp → Configuration → Verify token
WHATSAPP_VERIFY_TOKEN=embrace-hd-verify

# Approved authentication template for business-initiated OTP.
# Leave empty to use free-form text (only delivered within the 24h window).
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# Set false if your template has no copy-code button
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true

# Auth session / OTP
AUTH_OTP_TTL_SEC=300
SESSION_TTL_DAYS=30
# Return otpHint in request-otp when using mock (disable in production)
AUTH_ALLOW_OTP_HINT=true
# Fixed OTP that ALWAYS verifies — testing only. Leave empty in production!
AUTH_TEST_OTP=123456

# FFmpeg x264 speed/quality tradeoff (default veryfast). Options:
# ultrafast | superfast | veryfast | faster | fast | medium | slow | slower
FFMPEG_X264_PRESET=veryfast

# Observability: how often (seconds) to log the request-count summary. 0 disables.
REQUEST_LOG_INTERVAL_SEC=60

# Persistence backend: 'file' (local JSON, default) or 'dynamodb' (AWS only)
STORAGE_DRIVER=file
# DynamoDB (only when STORAGE_DRIVER=dynamodb)
AWS_REGION=eu-west-2
DDB_TABLE=embrace-hd
DDB_ENDPOINT=

# --- Hetzner / Docker Compose ---
# Public hostname for Caddy HTTPS (must resolve to this server)
API_DOMAIN=api.embraceapp.co.uk