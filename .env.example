# Embrace HD — local env (do not commit secrets)

# Node backend — phone must use your PC LAN IP or emulator gateway (not localhost)
VITE_BACKEND_ENABLED=true
VITE_API_BASE_URL=http://192.168.1.113:8787
# Android emulator: http://10.0.2.2:8787
# Desktop browser: http://localhost:8787

# Register → "Join the app" opens WhatsApp to this number with "Enroll me"
VITE_WHATSAPP_ENROLL_NUMBER=+447867057315

# AdMob (optional — Google sample IDs used when unset / test mode)
# VITE_ADMOB_TEST_MODE=true
# VITE_ADMOB_INTERSTITIAL_ID_ANDROID=
# VITE_ADMOB_INTERSTITIAL_ID_IOS=
